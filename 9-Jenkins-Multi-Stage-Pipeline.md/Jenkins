pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline.md') {
                    echo 'Installing dependencies...'
                    sh '''
                        python3 -m venv venv
                        venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline.md') {
                    echo 'Running tests...'
                    sh 'venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline.md') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "$WORKSPACE/python-app-deploy"
                        cp app.py "$WORKSPACE/python-app-deploy/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running application...'
                sh '''
                    nohup "$WORKSPACE/9-Jenkins-Multi-Stage-Pipeline.md/venv/bin/python" \
                    "$WORKSPACE/python-app-deploy/app.py" \
                    > "$WORKSPACE/python-app-deploy/app.log" 2>&1 &
                '''
            }
        }

        stage('Test Application') {
            steps {
                dir('9-Jenkins-Multi-Stage-Pipeline.md') {
                    echo 'Testing application...'
                    sh 'venv/bin/python test_app.py'
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs.'
        }
    }
}
